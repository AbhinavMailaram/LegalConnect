@model List<LegalConnect.Web.Models.Entities.Document>
@{
    ViewData["Title"] = "My Legal Documents";
    var isClient = User.IsInRole("Client");
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-folder2-open text-primary me-2"></i>Legal Documents Vault</h3>
                <p class="text-muted small mb-0">Confidential files uploaded in connection with legal consultations.</p>
            </div>
            @if (isClient)
            {
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
                    <i class="bi bi-upload me-1"></i> Upload General Document
                </button>
            }
        </div>

        <div class="card card-custom p-0 overflow-hidden shadow-sm">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-folder-x fs-1 text-secondary mb-2"></i>
                    <h5>No documents stored</h5>
                    <p class="small">Documents attached to appointments will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Document Name</th>
                                <th>Client</th>
                                <th>Linked Case</th>
                                <th>Uploaded Date</th>
                                <th>Size</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-file-earmark-text fs-4 text-primary"></i>
                                            <span class="fw-semibold">@doc.FileName</span>
                                        </div>
                                    </td>
                                    <td>@doc.Client.User.FullName</td>
                                    <td>
                                        @if (doc.Appointment != null)
                                        {
                                            <a asp-controller="Appointment" asp-action="Details" asp-route-id="@doc.AppointmentId" class="text-decoration-none">
                                                Appt #@doc.AppointmentId (@doc.Appointment.CaseTitle)
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">General Profile</span>
                                        }
                                    </td>
                                    <td>@doc.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                    <td>@((doc.FileSizeBytes / 1024.0).ToString("N1")) KB</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-outline-primary btn-sm" title="Download">
                                                <i class="bi bi-download"></i> Download
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@doc.DocumentId" method="post" onsubmit="return confirm('Delete this document?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Upload Modal -->
@if (isClient)
{
    <div class="modal fade" id="uploadModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title">Upload Legal Document</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Choose File (PDF, JPG, PNG, DOCX)</label>
                            <input type="file" name="file" class="form-control" required accept=".pdf,.jpg,.jpeg,.png,.docx" />
                            <small class="text-muted">Maximum allowed file size: 5MB.</small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm">Upload File</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
