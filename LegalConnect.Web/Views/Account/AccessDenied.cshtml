@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card card-custom p-5 shadow-sm border-danger">
            <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
            <h2 class="fw-bold text-danger">403 - Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have administrative or authorized role privileges to access this page.
                Role-based security ([Authorize(Roles = "...")]) has restricted this action.
            </p>
            <div class="mt-4 d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary">Admin Dashboard</a>
                }
                else if (User.IsInRole("Lawyer"))
                {
                    <a asp-controller="Lawyer" asp-action="Dashboard" class="btn btn-primary">Lawyer Dashboard</a>
                }
                else if (User.IsInRole("Client"))
                {
                    <a asp-controller="Client" asp-action="Dashboard" class="btn btn-primary">Client Dashboard</a>
                }
            </div>
        </div>
    </div>
</div>
