@model LegalConnect.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold mb-3"><i class="bi bi-key text-warning me-2"></i>Reset Password</h4>
            <p class="text-muted small">Enter the email associated with your account to receive a reset link.</p>

            @if (ViewBag.Success == true)
            {
                <div class="alert alert-success">
                    <p class="mb-2 fw-semibold">Academic Simulation Mode:</p>
                    <p class="small mb-2">Since this is a college/academic development demonstration, the reset link has been generated directly:</p>
                    <a href="@ViewBag.ResetLink" class="btn btn-outline-success btn-sm w-100 text-truncate">Proceed to Reset Password</a>
                </div>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Generate Reset Link</button>
                </form>
            }

            <div class="text-center mt-3">
                <a asp-action="Login" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
