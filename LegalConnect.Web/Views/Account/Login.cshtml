@model LegalConnect.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom shadow-sm p-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-primary fs-1"></i>
                <h3 class="fw-bold mt-2">Sign In</h3>
                <p class="text-muted small">Enter your credentials to access your LegalConnect portal</p>
            </div>

            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <a asp-action="ForgotPassword" class="small text-decoration-none">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
            </form>

            <div class="text-center mt-3 small">
                Don't have an account yet? <a asp-action="Register" class="fw-semibold">Register here</a>
            </div>
        </div>

        <!-- Academic Demo Login Helper -->
        <div class="card bg-light border-0 shadow-sm mt-3 p-3 small">
            <div class="fw-bold text-secondary mb-2"><i class="bi bi-info-circle me-1"></i> Quick Demo Accounts (Seeded):</div>
            <div class="row g-2">
                <div class="col-12">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100 text-start" onclick="fillCreds('admin@legalconnect.com', 'Admin@123')">
                        <strong>Admin:</strong> admin@legalconnect.com / Admin@123
                    </button>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-outline-primary btn-sm w-100 text-start" onclick="fillCreds('lawyer@legalconnect.com', 'Lawyer@123')">
                        <strong>Lawyer (Approved):</strong> lawyer@legalconnect.com / Lawyer@123
                    </button>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-outline-success btn-sm w-100 text-start" onclick="fillCreds('client@legalconnect.com', 'Client@123')">
                        <strong>Client:</strong> client@legalconnect.com / Client@123
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, pass) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = pass;
        }
    </script>
}
