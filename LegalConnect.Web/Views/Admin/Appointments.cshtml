@model List<LegalConnect.Web.Models.Entities.Appointment>
@{
    ViewData["Title"] = "Monitor Appointments (Admin)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar3 text-primary me-2"></i>Monitor Platform Appointments</h3>
        <p class="text-muted small mb-0">Platform-wide overview of all legal consultations and dispute mitigation.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
</div>

<div class="card card-custom p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Appt ID</th>
                    <th>Client</th>
                    <th>Lawyer</th>
                    <th>Date & Time</th>
                    <th>Case Subject</th>
                    <th>Mode</th>
                    <th>Status</th>
                    <th>Admin Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model)
                {
                    <tr>
                        <td><strong>#@appt.AppointmentId</strong></td>
                        <td>
                            <div class="fw-semibold">@appt.Client.User.FullName</div>
                            <small class="text-muted">@appt.Client.User.Phone</small>
                        </td>
                        <td>
                            <div class="fw-semibold">Adv. @appt.Lawyer.User.FullName</div>
                            <small class="text-muted">@appt.Lawyer.Specialization?.Name</small>
                        </td>
                        <td>
                            <div>@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                            <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm")</small>
                        </td>
                        <td>
                            <div class="fw-semibold">@appt.CaseTitle</div>
                            <small class="text-muted text-truncate d-inline-block" style="max-width: 180px;">@appt.CaseDescription</small>
                        </td>
                        <td><span class="badge bg-light text-dark border">@appt.ConsultationMode</span></td>
                        <td>
                            @if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted)
                            {
                                <span class="badge bg-primary">Accepted</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Completed)
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-outline-primary btn-sm" title="Inspect">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending || appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#adminCancelModal-@appt.AppointmentId" title="Cancel Record">
                                        <i class="bi bi-slash-circle"></i>
                                    </button>
                                }
                            </div>

                            <!-- Cancel Modal -->
                            <div class="modal fade" id="adminCancelModal-@appt.AppointmentId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="CancelAppointment" method="post">
                                            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                            <div class="modal-header">
                                                <h5 class="modal-title">Administrative Cancellation #@appt.AppointmentId</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <p class="text-muted small">Specify reason for cancelling this appointment:</p>
                                                <input type="text" name="reason" class="form-control" required placeholder="e.g. Terms violation or requested by party" />
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-danger btn-sm">Cancel Appointment</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
