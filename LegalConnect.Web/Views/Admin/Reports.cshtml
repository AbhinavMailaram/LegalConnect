@{
    ViewData["Title"] = "Platform Reports & Analytics";
    var specStats = ViewBag.SpecializationStats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-bar-chart-line text-primary me-2"></i>Platform Reports & Statistics</h3>
        <p class="text-muted small mb-0">System performance metrics, appointment completions, and practice area distribution.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
</div>

<div class="row g-4 mb-4">
    <!-- Appointments Lifecycle Analytics -->
    <div class="col-md-6">
        <div class="card card-custom p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-pie-chart-fill text-warning me-2"></i>Consultation Status Distribution</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-hourglass-split text-warning me-2"></i>Pending Requests</span>
                    <strong class="badge bg-warning text-dark fs-6">@ViewBag.PendingAppointments</strong>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-calendar2-check text-primary me-2"></i>Accepted / Upcoming</span>
                    <strong class="badge bg-primary fs-6">@ViewBag.AcceptedAppointments</strong>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-check2-circle text-success me-2"></i>Completed Consultations</span>
                    <strong class="badge bg-success fs-6">@ViewBag.CompletedAppointments</strong>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-x-circle text-danger me-2"></i>Cancelled / Rejected</span>
                    <strong class="badge bg-secondary fs-6">@ViewBag.CancelledAppointments</strong>
                </li>
            </ul>
            <div class="border-top pt-2 small text-muted d-flex justify-content-between">
                <span>Total Consultation Records:</span>
                <strong>@ViewBag.TotalAppointments</strong>
            </div>
        </div>
    </div>

    <!-- Lawyer Verification Metrics -->
    <div class="col-md-6">
        <div class="card card-custom p-4 shadow-sm h-100">
            <h5 class="fw-bold mb-3"><i class="bi bi-shield-check text-primary me-2"></i>Lawyer Verification Health</h5>
            <ul class="list-group list-group-flush mb-3">
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-patch-check-fill text-success me-2"></i>Verified & Searchable</span>
                    <strong class="badge bg-success fs-6">@ViewBag.ApprovedLawyers</strong>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-clock-history text-warning me-2"></i>Awaiting Verification</span>
                    <strong class="badge bg-warning text-dark fs-6">@ViewBag.PendingLawyers</strong>
                </li>
                <li class="d-flex justify-content-between align-items-center py-2">
                    <span><i class="bi bi-people text-info me-2"></i>Total Platform Users</span>
                    <strong class="badge bg-info text-dark fs-6">@ViewBag.TotalUsers</strong>
                </li>
            </ul>
            <div class="border-top pt-2 small text-muted d-flex justify-content-between">
                <span>Total Lawyer Accounts:</span>
                <strong>@ViewBag.TotalLawyers</strong>
            </div>
        </div>
    </div>
</div>

<!-- Specializations Distribution -->
<div class="card card-custom p-4 shadow-sm">
    <h5 class="fw-bold mb-3"><i class="bi bi-diagram-3 text-secondary me-2"></i>Lawyers Distribution by Legal Practice Area</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Practice Area Specialization</th>
                    <th>Associated Lawyers Count</th>
                    <th>Directory Share</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spec in specStats)
                {
                    var count = (int)spec.Count;
                    var totalLawyers = (int)ViewBag.TotalLawyers;
                    var percentage = totalLawyers > 0 ? (count * 100.0 / totalLawyers) : 0;
                    <tr>
                        <td class="fw-bold">@spec.Name</td>
                        <td><span class="badge bg-primary">@count Lawyer(s)</span></td>
                        <td style="width: 40%;">
                            <div class="progress" style="height: 12px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: @(percentage.ToString("F0"))%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
