@model LegalConnect.Web.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator Control Center";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-shaded text-danger me-2"></i>Admin Dashboard</h2>
        <p class="text-muted mb-0">System Oversight, User Administration, and Lawyer Credential Verification</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="VerifyLawyers" class="btn btn-warning btn-sm text-dark fw-bold position-relative">
            <i class="bi bi-patch-check me-1"></i> Verify Lawyers
            @if (Model.PendingVerifications > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @Model.PendingVerifications
                </span>
            }
        </a>
        <a asp-controller="Specialization" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-briefcase me-1"></i> Specializations
        </a>
        <a href="/swagger" target="_blank" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-code-square me-1"></i> Swagger API
        </a>
    </div>
</div>

<!-- Admin Summary Metric Cards (Document 1 Page 13) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Total Registered Users</div>
                    <h3 class="fw-bold text-primary mb-0">@Model.TotalUsers</h3>
                </div>
                <div class="rounded bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
            </div>
            <a asp-action="Users" class="small text-decoration-none mt-2 d-inline-block">Manage Users &rarr;</a>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Total Lawyers</div>
                    <h3 class="fw-bold text-info mb-0">@Model.TotalLawyers</h3>
                </div>
                <div class="rounded bg-info bg-opacity-10 p-3 text-info">
                    <i class="bi bi-briefcase-fill fs-4"></i>
                </div>
            </div>
            <a asp-action="Lawyers" class="small text-decoration-none mt-2 d-inline-block">View All Lawyers &rarr;</a>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Pending Verification</div>
                    <h3 class="fw-bold text-warning mb-0">@Model.PendingVerifications</h3>
                </div>
                <div class="rounded bg-warning bg-opacity-10 p-3 text-warning">
                    <i class="bi bi-patch-question-fill fs-4"></i>
                </div>
            </div>
            <a asp-action="VerifyLawyers" class="small text-decoration-none mt-2 d-inline-block">Review Queue &rarr;</a>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Total Appointments</div>
                    <h3 class="fw-bold text-success mb-0">@Model.TotalAppointments</h3>
                </div>
                <div class="rounded bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-calendar3 fs-4"></i>
                </div>
            </div>
            <a asp-action="Appointments" class="small text-decoration-none mt-2 d-inline-block">Monitor Appointments &rarr;</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Pending Lawyer Verifications -->
    <div class="col-lg-6">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-patch-exclamation-fill text-warning me-2"></i>Pending Lawyer Verifications
                </h5>
                <a asp-action="VerifyLawyers" class="btn btn-outline-primary btn-sm">Full Queue</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.PendingLawyers.Any())
                {
                    <div class="p-4 text-center text-muted small">
                        <i class="bi bi-check-circle fs-3 text-success d-block mb-1"></i>
                        No pending lawyer verifications. All advocates are currently processed!
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Lawyer</th>
                                    <th>Bar Reg. / Spec</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var lawyer in Model.PendingLawyers.Take(4))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@lawyer.User.FullName</div>
                                            <div class="text-muted">@lawyer.User.Email</div>
                                        </td>
                                        <td>
                                            <div>@(string.IsNullOrEmpty(lawyer.RegistrationNumber) ? "Pending details" : lawyer.RegistrationNumber)</div>
                                            <span class="badge bg-secondary">@(lawyer.Specialization?.Name ?? "Unassigned")</span>
                                        </td>
                                        <td>
                                            <a asp-action="VerifyLawyers" class="btn btn-warning btn-sm fw-bold">Review</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Appointments Monitoring -->
    <div class="col-lg-6">
        <div class="card card-custom shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-event text-primary me-2"></i>Recent Consultation Bookings
                </h5>
                <a asp-action="Appointments" class="btn btn-outline-primary btn-sm">All Consultations</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentAppointments.Any())
                {
                    <div class="p-4 text-center text-muted small">No appointments booked yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Client / Lawyer</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.RecentAppointments)
                                {
                                    <tr>
                                        <td>
                                            <div><strong>Client:</strong> @appt.Client.User.FullName</div>
                                            <div class="text-muted"><strong>Lawyer:</strong> @appt.Lawyer.User.FullName</div>
                                        </td>
                                        <td>
                                            <div>@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                            <div class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm")</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@appt.Status</span>
                                        </td>
                                        <td>
                                            <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-outline-primary btn-sm">
                                                Inspect
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent User Registrations -->
<div class="card card-custom shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-person-lines-fill text-secondary me-2"></i>Recent User Accounts
        </h5>
        <a asp-action="Users" class="btn btn-outline-secondary btn-sm">Manage All Users</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Email</th>
                        <th>Registered Date</th>
                        <th>Active Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.RecentUsers)
                    {
                        <tr>
                            <td class="fw-bold">@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Deactivated</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
