@model List<LegalConnect.Web.Models.Entities.LawyerProfile>
@{
    ViewData["Title"] = "Lawyer Verification Queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-patch-check text-warning me-2"></i>Lawyer Verification Queue</h3>
        <p class="text-muted small mb-0">Review pending lawyer registrations and verify Bar Council credentials.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
</div>

<div class="card card-custom p-0 overflow-hidden shadow-sm">
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-check2-circle fs-1 text-success mb-2"></i>
            <h5>No pending verifications</h5>
            <p class="small">All registered lawyers have been reviewed and processed.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Lawyer Profile</th>
                        <th>Bar Registration</th>
                        <th>Specialization</th>
                        <th>Qualification & Exp.</th>
                        <th>City / Office</th>
                        <th>Verification Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lawyer in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(lawyer.ProfilePhoto))
                                    {
                                        <img src="@lawyer.ProfilePhoto" alt="@lawyer.User.FullName" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-secondary"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold">@lawyer.User.FullName</div>
                                        <small class="text-muted">@lawyer.User.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(string.IsNullOrEmpty(lawyer.RegistrationNumber) ? "Not provided" : lawyer.RegistrationNumber)
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark">@(lawyer.Specialization?.Name ?? "Unassigned")</span>
                            </td>
                            <td>
                                <div>@(string.IsNullOrEmpty(lawyer.Qualification) ? "LL.B" : lawyer.Qualification)</div>
                                <small class="text-muted">@lawyer.ExperienceYears Years Experience</small>
                            </td>
                            <td>
                                <div>@lawyer.Location</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 150px;">@lawyer.Address</small>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form asp-action="ApproveLawyer" method="post" class="d-inline">
                                        <input type="hidden" name="lawyerId" value="@lawyer.LawyerId" />
                                        <button type="submit" class="btn btn-success btn-sm fw-semibold">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@lawyer.LawyerId">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@lawyer.LawyerId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="RejectLawyer" method="post">
                                                <input type="hidden" name="lawyerId" value="@lawyer.LawyerId" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reject Verification: @lawyer.User.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label small">Specify the rejection reason for the lawyer:</label>
                                                    <input type="text" name="reason" class="form-control" placeholder="e.g. Invalid Bar Registration Number, Incomplete Profile" required />
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
