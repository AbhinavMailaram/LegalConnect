@model List<LegalConnect.Web.Models.Entities.LawyerProfile>
@{
    ViewData["Title"] = "All Lawyers Directory (Admin)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>Lawyer Profiles Directory</h3>
        <p class="text-muted small mb-0">Overview of all lawyers registered on the platform and their verification states.</p>
    </div>
    <a asp-action="VerifyLawyers" class="btn btn-warning btn-sm text-dark fw-bold">Verification Queue</a>
</div>

<div class="card card-custom p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Lawyer Name</th>
                    <th>Email & Phone</th>
                    <th>Specialization</th>
                    <th>Bar Reg. Number</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Verification Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lawyer in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@lawyer.User.FullName</div>
                            <small class="text-muted">@lawyer.Qualification</small>
                        </td>
                        <td>
                            <div>@lawyer.User.Email</div>
                            <small class="text-muted">@lawyer.User.Phone</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@(lawyer.Specialization?.Name ?? "General")</span>
                        </td>
                        <td><code>@(string.IsNullOrEmpty(lawyer.RegistrationNumber) ? "None" : lawyer.RegistrationNumber)</code></td>
                        <td>@lawyer.ExperienceYears Yrs</td>
                        <td class="text-success fw-semibold">₹@lawyer.ConsultationFee.ToString("N0")</td>
                        <td>
                            @if (lawyer.VerificationStatus == LegalConnect.Web.Models.Entities.VerificationStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (lawyer.VerificationStatus == LegalConnect.Web.Models.Entities.VerificationStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending Review</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Lawyer" asp-action="Details" asp-route-id="@lawyer.LawyerId" class="btn btn-outline-primary btn-sm" target="_blank">
                                <i class="bi bi-eye"></i> View Profile
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
