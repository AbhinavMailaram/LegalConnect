@model LegalConnect.Web.Models.ViewModels.LawyerSearchViewModel
@{
    ViewData["Title"] = "Find & Filter Lawyers";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-search text-primary me-2"></i>Find Verified Advocates</h2>
    <p class="text-muted mb-0">Search certified legal professionals by specialization, city, or courtroom experience.</p>
</div>

<!-- Filters Card -->
<div class="card card-custom p-4 mb-4 shadow-sm bg-white">
    <form asp-action="FindLawyers" method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">Search Keyword</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="query" value="@Model.Query" class="form-control" placeholder="Name or keyword..." />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">Specialization</label>
                <select name="specializationId" asp-items="Model.SpecializationsList" class="form-select">
                    <option value="">All Practice Areas</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold small text-secondary">City / Location</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                    <input type="text" name="location" value="@Model.Location" class="form-control" placeholder="e.g. Mumbai" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold small text-secondary">Min. Experience</label>
                <select name="minExperience" class="form-select">
                    <option value="">Any Experience</option>
                    <option value="3" selected="@(Model.MinExperience == 3)">3+ Years</option>
                    <option value="5" selected="@(Model.MinExperience == 5)">5+ Years</option>
                    <option value="10" selected="@(Model.MinExperience == 10)">10+ Years</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-funnel-fill me-1"></i> Filter
                </button>
                <a asp-action="FindLawyers" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Lawyer Results List -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Verified Advocates (@Model.Results.Count)</h5>
</div>

@if (!Model.Results.Any())
{
    <div class="card card-custom p-5 text-center text-muted shadow-sm">
        <i class="bi bi-person-x fs-1 text-secondary mb-3"></i>
        <h5>No lawyers match your filter criteria</h5>
        <p class="small mb-3">Try adjusting your practice category or location filter to explore other available advocates.</p>
        <div>
            <a asp-action="FindLawyers" class="btn btn-outline-primary btn-sm">Clear All Filters</a>
        </div>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @foreach (var lawyer in Model.Results)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom h-100 shadow-sm overflow-hidden d-flex flex-column">
                    <div class="p-4 flex-grow-1">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(lawyer.ProfilePhoto))
                            {
                                <img src="@lawyer.ProfilePhoto" alt="@lawyer.FullName" class="rounded-circle shadow-sm" style="width: 65px; height: 65px; object-fit: cover; border: 2px solid #e2e8f0;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary shadow-sm" style="width: 65px; height: 65px; border: 2px solid #e2e8f0;">
                                    <i class="bi bi-person-fill fs-2"></i>
                                </div>
                            }
                            <div>
                                <span class="badge bg-warning text-dark extra-small mb-1">@lawyer.SpecializationName</span>
                                <h5 class="fw-bold mb-0 text-dark">@lawyer.FullName</h5>
                                <div class="text-muted small">
                                    <i class="bi bi-award me-1"></i>@lawyer.ExperienceYears Years Exp.
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 small">
                            <div class="text-secondary mb-1">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrEmpty(lawyer.Location) ? "City Office" : lawyer.Location)
                            </div>
                            <div class="text-secondary text-truncate">
                                <i class="bi bi-mortarboard-fill text-primary me-1"></i>@(string.IsNullOrEmpty(lawyer.Qualification) ? "LL.B" : lawyer.Qualification)
                            </div>
                        </div>

                        <p class="text-muted small mb-3" style="line-height: 1.5; height: 45px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                            @(string.IsNullOrWhiteSpace(lawyer.Description) ? "Professional advocate available for consultations." : lawyer.Description)
                        </p>

                        <div class="bg-light p-2 rounded-2 small d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Consultation:</span>
                            <strong class="text-success fs-6">₹@lawyer.ConsultationFee.ToString("N0")</strong>
                        </div>

                        @if (lawyer.Availabilities.Any())
                        {
                            <div class="small text-muted mb-2">
                                <i class="bi bi-clock me-1 text-primary"></i> Available:
                                <span class="badge bg-light text-dark border">
                                    @string.Join(", ", lawyer.Availabilities.Select(a => a.DayOfWeek.ToString().Substring(0, 3)).Distinct())
                                </span>
                            </div>
                        }
                    </div>

                    <div class="card-footer bg-white border-top p-3 d-flex gap-2">
                        <a asp-controller="Lawyer" asp-action="Details" asp-route-id="@lawyer.LawyerId" class="btn btn-outline-secondary btn-sm flex-grow-1">
                            Profile
                        </a>
                        <a asp-controller="Appointment" asp-action="Book" asp-route-lawyerId="@lawyer.LawyerId" class="btn btn-warning btn-sm fw-bold flex-grow-1">
                            Request
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
