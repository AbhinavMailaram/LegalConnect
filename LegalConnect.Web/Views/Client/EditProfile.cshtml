@model LegalConnect.Web.Models.ViewModels.ClientProfileEditViewModel
@{
    ViewData["Title"] = "Edit Client Profile";
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold mb-1"><i class="bi bi-person-gear text-primary me-2"></i>My Client Profile</h3>
            <p class="text-muted small mb-4">Manage your personal and contact details for consultation records.</p>

            <form asp-action="EditProfile" method="post">
                <input type="hidden" asp-for="ClientId" />
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="City" class="form-label fw-semibold"></label>
                    <input asp-for="City" class="form-control" placeholder="e.g. Mumbai, New Delhi" />
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-semibold"></label>
                    <textarea asp-for="Address" rows="2" class="form-control" placeholder="Residential or billing address"></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Update Profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
