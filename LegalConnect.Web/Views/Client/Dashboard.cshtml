@model LegalConnect.Web.Models.ViewModels.ClientDashboardViewModel
@{
    ViewData["Title"] = "Client Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Welcome, @Model.Client.User.FullName</h2>
        <p class="text-muted mb-0">Client Legal Consultation Portal</p>
    </div>
    <div class="d-flex gap-2 mt-2 mt-md-0">
        <a asp-action="FindLawyers" class="btn btn-warning fw-bold text-dark shadow-sm">
            <i class="bi bi-search me-1"></i> Find Lawyer
        </a>
        <a asp-action="EditProfile" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-person-gear me-1"></i> My Profile
        </a>
        <a asp-controller="Message" asp-action="Index" class="btn btn-outline-dark btn-sm position-relative">
            <i class="bi bi-chat-dots me-1"></i> Messages
            @if (Model.UnreadMessagesCount > 0)
            {
                <span class="badge bg-danger rounded-pill">@Model.UnreadMessagesCount</span>
            }
        </a>
    </div>
</div>

<!-- Summary Status Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Upcoming Consults</div>
                    <h3 class="fw-bold text-primary mb-0">@Model.UpcomingAppointments.Count</h3>
                </div>
                <div class="rounded bg-primary bg-opacity-10 p-3 text-primary">
                    <i class="bi bi-calendar-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Pending Requests</div>
                    <h3 class="fw-bold text-warning mb-0">@Model.PendingRequests.Count</h3>
                </div>
                <div class="rounded bg-warning bg-opacity-10 p-3 text-warning">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Completed Consults</div>
                    <h3 class="fw-bold text-success mb-0">@Model.CompletedConsultations.Count</h3>
                </div>
                <div class="rounded bg-success bg-opacity-10 p-3 text-success">
                    <i class="bi bi-check2-all fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-custom p-3 border-start border-secondary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">Cancelled / Closed</div>
                    <h3 class="fw-bold text-secondary mb-0">@Model.CancelledAppointments.Count</h3>
                </div>
                <div class="rounded bg-secondary bg-opacity-10 p-3 text-secondary">
                    <i class="bi bi-archive fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Active / Upcoming Consultations List -->
    <div class="col-lg-8">
        <div class="card card-custom shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-calendar-event-fill text-primary me-2"></i>Upcoming & Active Consultations
                </h5>
                <a asp-action="MyAppointments" class="btn btn-outline-primary btn-sm">View All History</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.UpcomingAppointments.Any() && !Model.PendingRequests.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-calendar-plus fs-1 text-secondary mb-2"></i>
                        <h5>No scheduled appointments yet</h5>
                        <p class="small mb-3">Browse our directory of verified advocates to request a legal consultation.</p>
                        <a asp-action="FindLawyers" class="btn btn-warning btn-sm fw-bold">Search Lawyers Now</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Lawyer</th>
                                    <th>Scheduled Date & Time</th>
                                    <th>Subject</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appt in Model.UpcomingAppointments.Concat(Model.PendingRequests))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">Adv. @appt.Lawyer.User.FullName</div>
                                            <small class="text-muted">@appt.Lawyer.Specialization?.Name</small>
                                        </td>
                                        <td>
                                            <div>@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                            <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm")</small>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@appt.CaseTitle</div>
                                            <small class="text-muted">Mode: @appt.ConsultationMode</small>
                                        </td>
                                        <td>
                                            @if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending)
                                            {
                                                <span class="badge bg-warning text-dark">Pending Lawyer</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Confirmed / Upcoming</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-outline-primary btn-sm" title="View Details">
                                                    Details
                                                </a>
                                                <a asp-controller="Message" asp-action="Thread" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-outline-secondary btn-sm" title="Chat">
                                                    <i class="bi bi-chat-text"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Quick Shortcuts & Recent Notifications -->
    <div class="col-lg-4">
        <!-- Quick Actions Card -->
        <div class="card card-custom p-4 shadow-sm mb-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions</h5>
            <div class="d-grid gap-2">
                <a asp-action="FindLawyers" class="btn btn-outline-primary text-start">
                    <i class="bi bi-search me-2"></i> Search Verified Lawyers
                </a>
                <a asp-action="MyAppointments" class="btn btn-outline-secondary text-start">
                    <i class="bi bi-calendar-week me-2"></i> View Consultation History
                </a>
                <a asp-controller="Document" asp-action="Index" class="btn btn-outline-dark text-start">
                    <i class="bi bi-folder2-open me-2"></i> Upload & View Documents
                </a>
                <a asp-action="EditProfile" class="btn btn-outline-info text-dark text-start">
                    <i class="bi bi-person-gear me-2"></i> Update Personal Profile
                </a>
            </div>
        </div>

        <!-- Recent Notifications -->
        <div class="card card-custom shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="bi bi-bell-fill text-warning me-2"></i>Recent Notifications</h6>
                <a asp-controller="Home" asp-action="Notifications" class="small text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentNotifications.Any())
                {
                    <div class="p-3 text-center text-muted small">No recent notifications.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush small">
                        @foreach (var note in Model.RecentNotifications)
                        {
                            <li class="list-group-item p-3 @(!note.IsRead ? "bg-light" : "")">
                                <div class="fw-semibold @(!note.IsRead ? "text-primary" : "")">@note.Title</div>
                                <div class="text-secondary small">@note.Message</div>
                                <div class="text-muted extra-small mt-1" style="font-size: 0.72rem;">@note.CreatedAt.ToLocalTime().ToString("g")</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
