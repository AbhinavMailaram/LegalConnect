@model List<LegalConnect.Web.Models.Entities.Notification>
@{
    ViewData["Title"] = "Your Notifications";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0"><i class="bi bi-bell-fill text-warning me-2"></i>Notifications</h3>
            <span class="badge bg-secondary">Total: @Model.Count</span>
        </div>

        @if (!Model.Any())
        {
            <div class="card card-custom p-5 text-center text-muted">
                <i class="bi bi-bell-slash fs-1 text-secondary mb-2"></i>
                <h5>No notifications yet</h5>
                <p class="small mb-0">You're all caught up! You will be notified when your appointments are updated or messages arrive.</p>
            </div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var note in Model)
                {
                    <div class="list-group-item list-group-item-action p-3 @(!note.IsRead ? "bg-light border-start border-primary border-4" : "")">
                        <div class="d-flex w-100 justify-content-between align-items-start">
                            <h6 class="mb-1 fw-bold @(!note.IsRead ? "text-primary" : "text-dark")">
                                <i class="bi bi-info-circle me-1"></i> @note.Title
                            </h6>
                            <small class="text-muted">@note.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</small>
                        </div>
                        <p class="mb-1 text-secondary small">@note.Message</p>
                    </div>
                }
            </div>
        }
    </div>
</div>
