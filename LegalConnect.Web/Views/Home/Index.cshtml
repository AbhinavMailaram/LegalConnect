@{
    ViewData["Title"] = "Online Lawyer-Client Connection Platform";
    var specializations = ViewBag.Specializations as List<LegalConnect.Web.Models.Entities.Specialization> ?? new();
}

<!-- Hero Section -->
<div class="p-5 mb-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0a192f 0%, #1e3a8a 70%, #172554 100%);">
    <div class="container-fluid py-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 fw-semibold mb-3">
                    <i class="bi bi-patch-check-fill me-1"></i> Verified Legal Consultations
                </span>
                <h1 class="display-5 fw-bold mb-3">Trusted Legal Advice, Simplified.</h1>
                <p class="fs-5 text-light opacity-90 col-md-11 mb-4">
                    Connect directly with verified advocates and legal specialists. Search by practice area, view verified credentials, inspect transparent fee structures, and book appointments seamlessly.
                </p>

                <!-- Search Bar Form -->
                <form asp-controller="Client" asp-action="FindLawyers" method="get" class="row g-2 bg-white p-2 rounded-3 shadow-lg col-lg-11 text-dark">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="query" class="form-control border-0 shadow-none" placeholder="Search lawyer name or practice..." />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select name="specializationId" class="form-select border-0 shadow-none border-start">
                            <option value="">All Specializations</option>
                            @foreach (var spec in specializations)
                            {
                                <option value="@spec.SpecializationId">@spec.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <i class="bi bi-bank2 display-1 text-warning opacity-75"></i>
            </div>
        </div>
    </div>
</div>

<!-- Platform Highlights Stats -->
<div class="row g-3 mb-5 text-center">
    <div class="col-md-4">
        <div class="card card-custom p-4">
            <h2 class="display-6 fw-bold text-primary mb-1">@(ViewBag.VerifiedLawyersCount ?? 1)+</h2>
            <div class="text-muted fw-semibold">Verified Professional Advocates</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4">
            <h2 class="display-6 fw-bold text-warning mb-1">10</h2>
            <div class="text-muted fw-semibold">Key Legal Practice Categories</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-4">
            <h2 class="display-6 fw-bold text-success mb-1">@(ViewBag.ConsultationsCount ?? 1)+</h2>
            <div class="text-muted fw-semibold">Consultations Completed</div>
        </div>
    </div>
</div>

<!-- Practice Areas / Specializations Section -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Explore Legal Practice Areas</h3>
            <p class="text-muted mb-0">Browse certified practitioners by area of specialized law</p>
        </div>
        <a asp-controller="Client" asp-action="FindLawyers" class="btn btn-outline-primary btn-sm">
            View All Lawyers <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var spec in specializations)
        {
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Client" asp-action="FindLawyers" asp-route-specializationId="@spec.SpecializationId" class="text-decoration-none text-dark">
                    <div class="card card-custom h-100 p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                                <i class="bi bi-briefcase-fill fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1">@spec.Name</h6>
                                <p class="text-muted small mb-0 text-truncate" style="max-width: 170px;">@spec.Description</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- How It Works Section -->
<div class="card card-custom p-5 mb-5 bg-white">
    <div class="text-center mb-4">
        <h3 class="fw-bold">How LegalConnect Works</h3>
        <p class="text-muted">A streamlined, transparent consultation workflow</p>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="rounded-circle bg-light p-3 mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-search fs-3 text-primary"></i>
            </div>
            <h5 class="fw-bold">1. Find Verified Counsel</h5>
            <p class="text-muted small">Search by legal field, location, or experience. Review credentials and verified Bar records.</p>
        </div>
        <div class="col-md-4">
            <div class="rounded-circle bg-light p-3 mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-calendar-check fs-3 text-warning"></i>
            </div>
            <h5 class="fw-bold">2. Book Appointment</h5>
            <p class="text-muted small">Select an available schedule slot, provide case details, and choose between online or in-person consultation.</p>
        </div>
        <div class="col-md-4">
            <div class="rounded-circle bg-light p-3 mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-chat-text fs-3 text-success"></i>
            </div>
            <h5 class="fw-bold">3. Consult & Share Files</h5>
            <p class="text-muted small">Exchange case inquiries directly on the platform and securely upload relevant case documents.</p>
        </div>
    </div>
</div>

<!-- CTA Banner -->
<div class="p-4 rounded-3 bg-primary text-white d-flex flex-wrap justify-content-between align-items-center">
    <div>
        <h4 class="fw-bold mb-1">Are you a practicing Advocate?</h4>
        <p class="mb-0 text-light opacity-90 small">Register your practice profile on LegalConnect to connect with clients seeking your specialization.</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-controller="Account" asp-action="Register" asp-route-role="Lawyer" class="btn btn-warning fw-bold px-4">
            Register as Lawyer
        </a>
    </div>
</div>
