@{
    ViewData["Title"] = "About LegalConnect";
}

<div class="row justify-content-center mt-3">
    <div class="col-lg-10">
        <div class="card card-custom p-5 mb-4">
            <h2 class="fw-bold text-primary mb-3">About LegalConnect</h2>
            <p class="lead text-muted">
                LegalConnect is an academic-grade, modern ASP.NET Core platform engineered to bridge the communication gap between individuals seeking legal assistance and certified advocates.
            </p>
            <hr class="my-4">

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <h5 class="fw-bold text-dark"><i class="bi bi-bullseye text-warning me-2"></i>Core Objectives</h5>
                    <ul class="text-muted small lh-lg">
                        <li>Democratize access to verified legal representation across diverse domains.</li>
                        <li>Facilitate verified lawyer onboarding with administrative Bar credential checks.</li>
                        <li>Offer conflict-free, structured appointment booking against declared lawyer availability.</li>
                        <li>Provide centralized case inquiry messaging and document management.</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h5 class="fw-bold text-dark"><i class="bi bi-cpu text-primary me-2"></i>Built with Modern .NET Architecture</h5>
                    <ul class="text-muted small lh-lg">
                        <li><strong>Backend:</strong> ASP.NET Core MVC (.NET 8 LTS) with Dependency Injection</li>
                        <li><strong>Database & ORM:</strong> SQL Server + Entity Framework Core (Code-First)</li>
                        <li><strong>Security:</strong> ASP.NET Core Identity with Role-Based Access Control (Admin, Lawyer, Client)</li>
                        <li><strong>API:</strong> Swagger OpenAPI documented endpoints</li>
                    </ul>
                </div>
            </div>

            <div class="alert alert-light border">
                <h6 class="fw-bold mb-1"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Academic Project Scope</h6>
                <p class="small text-muted mb-0">
                    Developed strictly following academic guidelines for full-stack .NET software engineering. Demonstrates repository pattern/services, relational integrity with SQL Server cascade protection, file uploads, authentication filters, and responsive design.
                </p>
            </div>
        </div>
    </div>
</div>
