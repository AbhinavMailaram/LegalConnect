@model List<LegalConnect.Web.Models.ViewModels.SpecializationCrudViewModel>
@{
    ViewData["Title"] = "Manage Specializations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-briefcase text-primary me-2"></i>Legal Specializations</h3>
        <p class="text-muted small mb-0">Manage legal practice disciplines available for lawyer categorization.</p>
    </div>
    <a asp-action="Create" class="btn btn-warning fw-bold btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Add Specialization
    </a>
</div>

<div class="card card-custom p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>ID</th>
                    <th>Specialization Name</th>
                    <th>Practice Description</th>
                    <th>Registered Lawyers</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var spec in Model)
                {
                    <tr>
                        <td>#@spec.SpecializationId</td>
                        <td class="fw-bold text-dark">@spec.Name</td>
                        <td class="text-muted small">@spec.Description</td>
                        <td>
                            <span class="badge bg-light text-dark border">@spec.AssociatedLawyersCount Lawyer(s)</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@spec.SpecializationId" class="btn btn-outline-primary btn-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@spec.SpecializationId" method="post" class="d-inline" onsubmit="return confirm('Delete this specialization?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
