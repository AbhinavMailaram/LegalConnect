@model LegalConnect.Web.Models.ViewModels.SpecializationCrudViewModel
@{
    ViewData["Title"] = "Edit Specialization - " + Model.Name;
}

<div class="row justify-content-center mt-3">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 shadow-sm">
            <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Practice Area</h4>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="SpecializationId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
