@model List<LegalConnect.Web.Models.Entities.Appointment>
@{
    ViewData["Title"] = "My Appointments (Lawyer)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-calendar3 text-primary me-2"></i>All Consultation Appointments</h3>
        <p class="text-muted small mb-0">Review consultation history, upcoming sessions, and pending requests.</p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
</div>

<div class="card card-custom p-0 overflow-hidden shadow-sm">
    @if (!Model.Any())
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 text-secondary mb-2"></i>
            <h5>No appointment records found</h5>
            <p class="small">Incoming appointments will appear here once clients request consultations.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Appointment ID</th>
                        <th>Client</th>
                        <th>Date & Time</th>
                        <th>Subject</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td>#@appt.AppointmentId</td>
                            <td>
                                <div class="fw-bold">@appt.Client.User.FullName</div>
                                <small class="text-muted">@appt.Client.User.Phone</small>
                            </td>
                            <td>
                                <div>@appt.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                <small class="text-muted">@appt.AppointmentTime.ToString(@"hh\:mm")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@appt.CaseTitle</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;">@appt.CaseDescription</small>
                            </td>
                            <td>
                                <span class="badge @(appt.ConsultationMode == LegalConnect.Web.Models.Entities.ConsultationMode.Online ? "bg-info text-dark" : "bg-secondary")">
                                    @appt.ConsultationMode
                                </span>
                            </td>
                            <td>
                                @if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted)
                                {
                                    <span class="badge bg-primary">Accepted / Upcoming</span>
                                }
                                else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Completed)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Appointment" asp-action="Details" asp-route-id="@appt.AppointmentId" class="btn btn-outline-primary btn-sm" title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <a asp-controller="Message" asp-action="Thread" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-outline-secondary btn-sm" title="Messages">
                                        <i class="bi bi-chat-text"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
