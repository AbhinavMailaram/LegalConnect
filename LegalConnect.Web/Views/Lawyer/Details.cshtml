@model LegalConnect.Web.Models.ViewModels.LawyerPublicProfileViewModel
@{
    ViewData["Title"] = "Lawyer Profile - " + Model.FullName;
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-9">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Client" asp-action="FindLawyers">Find Lawyers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>

        <div class="card card-custom overflow-hidden shadow-sm">
            <!-- Header bar -->
            <div class="bg-primary text-white p-4 d-flex flex-wrap justify-content-between align-items-center" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
                <div>
                    <span class="badge bg-warning text-dark px-3 py-1 mb-2 fw-semibold">
                        <i class="bi bi-briefcase-fill me-1"></i> @Model.SpecializationName
                    </span>
                    <h2 class="fw-bold mb-1">@Model.FullName</h2>
                    <p class="mb-0 text-light opacity-90 small">
                        <i class="bi bi-geo-alt-fill text-warning me-1"></i> @Model.Location &bull;
                        <i class="bi bi-award-fill text-warning ms-2 me-1"></i> @Model.ExperienceYears Years Experience
                    </p>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    @if (Model.VerificationStatus == LegalConnect.Web.Models.Entities.VerificationStatus.Approved)
                    {
                        <span class="badge bg-success px-3 py-2 fs-6">
                            <i class="bi bi-patch-check-fill me-1"></i> Bar Verified Advocate
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2">
                            <i class="bi bi-clock-history me-1"></i> Verification Pending
                        </span>
                    }
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row g-4">
                    <!-- Photo & Quick Info Column -->
                    <div class="col-md-4 text-center border-end">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
                            {
                                <img src="@Model.ProfilePhoto" alt="@Model.FullName" class="img-fluid rounded-circle shadow-sm" style="width: 170px; height: 170px; object-fit: cover; border: 4px solid #f1f5f9;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center text-primary shadow-sm" style="width: 170px; height: 170px; border: 4px solid #f1f5f9;">
                                    <i class="bi bi-person-fill display-1"></i>
                                </div>
                            }
                        </div>

                        <div class="card bg-light border-0 p-3 mb-3 text-start">
                            <div class="small text-muted mb-1">Consultation Fee</div>
                            <h4 class="fw-bold text-success mb-0">₹@Model.ConsultationFee.ToString("N0")</h4>
                            <small class="text-muted">per consultation session</small>
                        </div>

                        <div class="card bg-light border-0 p-3 text-start small mb-3">
                            <div class="mb-2">
                                <strong class="text-secondary"><i class="bi bi-card-heading me-1"></i> Bar Reg No:</strong>
                                <div>@(string.IsNullOrEmpty(Model.RegistrationNumber) ? "Pending Bar Details" : Model.RegistrationNumber)</div>
                            </div>
                            <div class="mb-2">
                                <strong class="text-secondary"><i class="bi bi-mortarboard me-1"></i> Qualifications:</strong>
                                <div>@(string.IsNullOrEmpty(Model.Qualification) ? "LL.B" : Model.Qualification)</div>
                            </div>
                            <div>
                                <strong class="text-secondary"><i class="bi bi-building me-1"></i> Chamber / Office:</strong>
                                <div>@(string.IsNullOrEmpty(Model.Address) ? Model.Location : Model.Address)</div>
                            </div>
                        </div>

                        <a asp-controller="Appointment" asp-action="Book" asp-route-lawyerId="@Model.LawyerId" class="btn btn-warning w-100 py-2 fw-bold text-dark shadow-sm">
                            <i class="bi bi-calendar-check-fill me-1"></i> Request Appointment
                        </a>
                    </div>

                    <!-- Details & Schedule Column -->
                    <div class="col-md-8 ps-md-4">
                        <h4 class="fw-bold text-dark mb-3">Professional Profile & Background</h4>
                        <p class="text-secondary" style="line-height: 1.7; white-space: pre-line;">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "Experienced advocate specializing in legal advisory, case filings, and representation. Contact for tailored counsel." : Model.Description)
                        </p>

                        <hr class="my-4" />

                        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-calendar3 text-primary me-2"></i>Weekly Consultation Availability</h5>
                        @if (!Model.Availabilities.Any())
                        {
                            <div class="alert alert-info small">
                                <i class="bi bi-info-circle me-1"></i> General availability: Monday to Friday. Please click "Request Appointment" to select a preferred schedule slot.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Day</th>
                                            <th>Available Time Window</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var slot in Model.Availabilities)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@slot.DayOfWeek</td>
                                                <td>@slot.StartTime.ToString(@"hh\:mm") – @slot.EndTime.ToString(@"hh\:mm")</td>
                                                <td><span class="badge bg-success">Available</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="mt-4 p-3 bg-light rounded-3 d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-bold mb-0">Ready to consult Adv. @Model.FullName?</h6>
                                <small class="text-muted">Choose your desired date, problem brief, and consultation mode.</small>
                            </div>
                            <a asp-controller="Appointment" asp-action="Book" asp-route-lawyerId="@Model.LawyerId" class="btn btn-primary fw-semibold">
                                Book Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
