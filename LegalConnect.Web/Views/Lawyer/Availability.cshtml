@model LegalConnect.Web.Models.ViewModels.LawyerAvailabilityViewModel
@{
    ViewData["Title"] = "Manage Weekly Availability";
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-9">
        <div class="card card-custom p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Weekly Consultation Availability</h3>
                    <p class="text-muted small mb-0">Set the days and time windows during which clients can request consultations.</p>
                </div>
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
            </div>

            <form asp-action="Availability" method="post">
                <input type="hidden" asp-for="LawyerId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small"></div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 20%;">Day of Week</th>
                                <th style="width: 25%;">Available for Consults?</th>
                                <th style="width: 25%;">Start Time</th>
                                <th style="width: 25%;">End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Slots.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="Slots[@i].DayOfWeek" value="@Model.Slots[i].DayOfWeek" />
                                        <strong class="text-dark">@Model.Slots[i].DayOfWeek</strong>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" name="Slots[@i].IsAvailable" value="true" @(Model.Slots[i].IsAvailable ? "checked" : "") id="check-@i" />
                                            <label class="form-check-label small" for="check-@i">Active</label>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="time" name="Slots[@i].StartTimeString" value="@Model.Slots[i].StartTimeString" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input type="time" name="Slots[@i].EndTimeString" value="@Model.Slots[i].EndTimeString" class="form-control form-control-sm" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Clients will only be offered slots matching your active schedule windows.</small>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Schedule</button>
                </div>
            </form>
        </div>
    </div>
</div>
