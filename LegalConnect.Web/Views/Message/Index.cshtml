@model List<LegalConnect.Web.Models.Entities.Appointment>
@{
    ViewData["Title"] = "Consultation Messages";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-chat-dots text-primary me-2"></i>Case Discussions</h3>
                <p class="text-muted small mb-0">Direct consultation messaging between clients and legal counsel.</p>
            </div>
        </div>

        <div class="card card-custom p-0 overflow-hidden shadow-sm">
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-chat-square-dots fs-1 text-secondary mb-2"></i>
                    <h5>No active conversations</h5>
                    <p class="small">Conversations are established when consultations are booked.</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var appt in Model)
                    {
                        var isClient = appt.Client.UserId == currentUserId;
                        var otherUser = isClient ? appt.Lawyer.User : appt.Client.User;
                        var otherRole = isClient ? "Advocate" : "Client";
                        var lastMessage = appt.Messages.OrderByDescending(m => m.SentAt).FirstOrDefault();
                        var unreadInThread = appt.Messages.Count(m => m.ReceiverId == currentUserId && !m.IsRead);

                        <a asp-action="Thread" asp-route-appointmentId="@appt.AppointmentId" class="list-group-item list-group-item-action p-3 @(unreadInThread > 0 ? "bg-light border-start border-primary border-4" : "")">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                <div>
                                    <h6 class="mb-0 fw-bold @(unreadInThread > 0 ? "text-primary" : "text-dark")">
                                        @otherUser.FullName <span class="badge bg-secondary extra-small fw-normal ms-1">@otherRole</span>
                                    </h6>
                                    <small class="text-muted">Matter: @appt.CaseTitle (Appt #@appt.AppointmentId)</small>
                                </div>
                                <div class="text-end">
                                    @if (lastMessage != null)
                                    {
                                        <small class="text-muted">@lastMessage.SentAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</small>
                                    }
                                    @if (unreadInThread > 0)
                                    {
                                        <div><span class="badge bg-danger rounded-pill">@unreadInThread new</span></div>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 text-secondary small text-truncate" style="max-width: 600px;">
                                @(lastMessage != null ? lastMessage.MessageText : "No messages exchanged yet. Click to start discussion.")
                            </p>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
