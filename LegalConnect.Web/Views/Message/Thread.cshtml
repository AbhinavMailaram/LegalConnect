@model LegalConnect.Web.Models.ViewModels.MessageThreadViewModel
@{
    ViewData["Title"] = "Discussion with " + Model.OtherUserName;
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-8">
        <div class="card card-custom shadow-sm overflow-hidden d-flex flex-column" style="height: 75vh;">
            <!-- Thread Header -->
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i></a>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 text-primary">
                        <i class="bi bi-person-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">@Model.OtherUserName <span class="badge bg-secondary extra-small fw-normal">@Model.OtherUserRole</span></h6>
                        @if (Model.Appointment != null)
                        {
                            <small class="text-muted">Matter: @Model.Appointment.CaseTitle (Appt #@Model.AppointmentId)</small>
                        }
                    </div>
                </div>
                @if (Model.AppointmentId.HasValue)
                {
                    <a asp-controller="Appointment" asp-action="Details" asp-route-id="@Model.AppointmentId.Value" class="btn btn-outline-primary btn-sm">
                        View Case Details
                    </a>
                }
            </div>

            <!-- Messages List -->
            <div class="flex-grow-1 p-3 overflow-auto bg-light" id="messageList">
                @if (!Model.Messages.Any())
                {
                    <div class="text-center text-muted small p-5">
                        <i class="bi bi-chat-heart fs-2 text-secondary mb-2"></i>
                        <p class="mb-0">This conversation is starting now. Send a message to discuss case particulars.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in Model.Messages)
                    {
                        var isMe = msg.SenderId == Model.CurrentUserId;
                        <div class="d-flex flex-column @(isMe ? "align-items-end" : "align-items-start") mb-3">
                            <div class="p-3 rounded-3 @(isMe ? "bg-primary text-white" : "bg-white text-dark border")" style="max-width: 75%;">
                                <div class="fw-semibold extra-small opacity-75 mb-1" style="font-size: 0.72rem;">
                                    @(isMe ? "You" : Model.OtherUserName)
                                </div>
                                <div style="white-space: pre-wrap; word-break: break-word;">@msg.MessageText</div>
                            </div>
                            <span class="text-muted extra-small mt-1 px-1" style="font-size: 0.7rem;">
                                @msg.SentAt.ToLocalTime().ToString("MMM dd, hh:mm tt")
                            </span>
                        </div>
                    }
                }
            </div>

            <!-- Message Input Footer -->
            <div class="p-3 bg-white border-top">
                <form asp-action="SendMessage" method="post" class="d-flex gap-2">
                    <input type="hidden" name="appointmentId" value="@Model.AppointmentId" />
                    <input type="hidden" name="receiverId" value="@Model.OtherUserId" />
                    <input type="text" name="messageText" class="form-control" placeholder="Type your message..." required autocomplete="off" autofocus />
                    <button type="submit" class="btn btn-primary px-4 fw-semibold"><i class="bi bi-send-fill me-1"></i> Send</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var messageContainer = document.getElementById("messageList");
        if (messageContainer) {
            messageContainer.scrollTop = messageContainer.scrollHeight;
        }
    </script>
}
