@model LegalConnect.Web.Models.ViewModels.AppointmentDetailsViewModel
@{
    var appt = Model.Appointment;
    ViewData["Title"] = $"Appointment #{appt.AppointmentId} Details";
    var isClient = Model.CurrentUserRole == "Client";
    var isLawyer = Model.CurrentUserRole == "Lawyer";
    var isAdmin = Model.CurrentUserRole == "Admin";
}

<div class="row justify-content-center mt-3 mb-5">
    <div class="col-lg-10">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold mb-1">Appointment #@appt.AppointmentId</h3>
                <span class="text-muted small">Created on @appt.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</span>
            </div>
            <div>
                @if (isLawyer)
                {
                    <a asp-controller="Lawyer" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
                }
                else if (isClient)
                {
                    <a asp-controller="Client" asp-action="MyAppointments" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> My Appointments</a>
                }
                else
                {
                    <a asp-controller="Admin" asp-action="Appointments" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> All Appointments</a>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Appointment Info & Actions -->
            <div class="col-lg-7">
                <div class="card card-custom p-4 shadow-sm mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge @(appt.ConsultationMode == LegalConnect.Web.Models.Entities.ConsultationMode.Online ? "bg-info text-dark" : "bg-secondary")">
                            Mode: @appt.ConsultationMode
                        </span>
                        <div>
                            @if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark fs-6">Pending Review</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted)
                            {
                                <span class="badge bg-primary fs-6">Confirmed / Upcoming</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Completed)
                            {
                                <span class="badge bg-success fs-6">Completed</span>
                            }
                            else if (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Rejected)
                            {
                                <span class="badge bg-danger fs-6">Rejected</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">Cancelled</span>
                            }
                        </div>
                    </div>

                    <h4 class="fw-bold text-dark mb-2">@appt.CaseTitle</h4>

                    <div class="bg-light p-3 rounded-2 mb-3 small">
                        <div class="row g-2">
                            <div class="col-6">
                                <strong>Date:</strong> @appt.AppointmentDate.ToString("yyyy-MM-dd")
                            </div>
                            <div class="col-6">
                                <strong>Time:</strong> @appt.AppointmentTime.ToString(@"hh\:mm")
                            </div>
                            <div class="col-6">
                                <strong>Client:</strong> @appt.Client.User.FullName
                            </div>
                            <div class="col-6">
                                <strong>Lawyer:</strong> Adv. @appt.Lawyer.User.FullName
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary mb-2">Case Problem Description:</h6>
                    <p class="text-secondary small bg-white p-3 border rounded-2" style="white-space: pre-line; line-height: 1.6;">
                        @appt.CaseDescription
                    </p>

                    <!-- Role Action Buttons -->
                    <div class="border-top pt-3 mt-3 d-flex flex-wrap gap-2">
                        @if (isLawyer && appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending)
                        {
                            <form asp-action="Accept" asp-route-id="@appt.AppointmentId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> Accept Appointment</button>
                            </form>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal">
                                <i class="bi bi-x-lg"></i> Reject
                            </button>
                        }

                        @if (isLawyer && appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted)
                        {
                            <form asp-action="Complete" asp-route-id="@appt.AppointmentId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-success btn-sm"><i class="bi bi-check2-circle"></i> Mark as Completed</button>
                            </form>
                        }

                        @if (isClient && (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending || appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted))
                        {
                            <form asp-action="Cancel" asp-route-id="@appt.AppointmentId" method="post" class="d-inline" onsubmit="return confirm('Cancel this appointment request?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-x-circle"></i> Cancel Appointment</button>
                            </form>
                        }

                        @if (isAdmin && (appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Pending || appt.Status == LegalConnect.Web.Models.Entities.AppointmentStatus.Accepted))
                        {
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#adminCancelModal">
                                <i class="bi bi-slash-circle"></i> Admin Cancel Record
                            </button>
                        }

                        <a asp-controller="Message" asp-action="Thread" asp-route-appointmentId="@appt.AppointmentId" class="btn btn-primary btn-sm ms-auto">
                            <i class="bi bi-chat-dots-fill me-1"></i> Open Case Chat
                        </a>
                    </div>
                </div>

                <!-- Attached Documents Section -->
                <div class="card card-custom p-4 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-text text-primary me-2"></i>Case Documents</h5>
                        <span class="badge bg-secondary">@appt.Documents.Count Files</span>
                    </div>

                    @if (!appt.Documents.Any())
                    {
                        <p class="text-muted small mb-3">No documents have been uploaded for this appointment yet.</p>
                    }
                    else
                    {
                        <div class="list-group mb-3">
                            @foreach (var doc in appt.Documents)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-file-earmark-pdf fs-4 text-danger"></i>
                                        <div>
                                            <div class="fw-bold small">@doc.FileName</div>
                                            <div class="text-muted extra-small" style="font-size: 0.75rem;">
                                                Uploaded @doc.UploadedAt.ToLocalTime().ToString("g") &bull; @((doc.FileSizeBytes / 1024.0).ToString("N1")) KB
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Document" asp-action="Download" asp-route-id="@doc.DocumentId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-download"></i>
                                        </a>
                                        @if (isClient || isAdmin)
                                        {
                                            <form asp-controller="Document" asp-action="Delete" asp-route-id="@doc.DocumentId" method="post" onsubmit="return confirm('Delete this document?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Client Upload Form -->
                    @if (isClient)
                    {
                        <div class="border-top pt-3">
                            <h6 class="fw-bold small mb-2 text-secondary">Upload Supporting Case Document</h6>
                            <form asp-controller="Document" asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                                <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                                <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png,.docx" required />
                                <button type="submit" class="btn btn-secondary btn-sm text-nowrap"><i class="bi bi-upload"></i> Upload</button>
                            </form>
                            <small class="text-muted" style="font-size: 0.75rem;">Max 5MB. PDF, JPG, PNG, DOCX supported.</small>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Column: Case Messaging Feed -->
            <div class="col-lg-5">
                <div class="card card-custom p-4 shadow-sm h-100 d-flex flex-column">
                    <h5 class="fw-bold text-dark mb-3"><i class="bi bi-chat-left-text text-primary me-2"></i>Consultation Discussion</h5>

                    <div class="flex-grow-1 overflow-auto p-2 border rounded-2 mb-3 bg-light" style="max-height: 420px; min-height: 250px;">
                        @if (!appt.Messages.Any())
                        {
                            <div class="text-center text-muted small p-4">
                                <i class="bi bi-chat fs-2 text-secondary mb-2"></i>
                                <p class="mb-0">No messages in this case thread yet. Post an inquiry or update below.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var msg in appt.Messages.OrderBy(m => m.SentAt))
                            {
                                var isMe = msg.SenderId == Model.CurrentUserId;
                                <div class="d-flex flex-column @(isMe ? "align-items-end" : "align-items-start") mb-2">
                                    <div class="p-2 rounded-3 small @(isMe ? "bg-primary text-white" : "bg-white text-dark border")" style="max-width: 85%;">
                                        <div class="extra-small opacity-75 mb-1" style="font-size: 0.7rem;">@msg.Sender.FullName</div>
                                        <div>@msg.MessageText</div>
                                    </div>
                                    <span class="text-muted extra-small mt-1" style="font-size: 0.68rem;">@msg.SentAt.ToLocalTime().ToString("hh:mm tt")</span>
                                </div>
                            }
                        }
                    </div>

                    <!-- Send Message Form -->
                    <form asp-controller="Message" asp-action="SendMessage" method="post">
                        <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                        <input type="hidden" name="receiverId" value="@(isClient ? appt.Lawyer.UserId : appt.Client.UserId)" />
                        <div class="input-group">
                            <input type="text" name="messageText" class="form-control" placeholder="Type a message..." required />
                            <button type="submit" class="btn btn-primary"><i class="bi bi-send-fill"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lawyer Reject Modal -->
@if (isLawyer)
{
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Reject" asp-route-id="@appt.AppointmentId" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Decline Appointment</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small">Reason for client:</label>
                        <input type="text" name="reason" class="form-control" placeholder="e.g. Prior courtroom commitment" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm">Confirm Decline</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Admin Cancel Modal -->
@if (isAdmin)
{
    <div class="modal fade" id="adminCancelModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Admin" asp-action="CancelAppointment" method="post">
                    <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
                    <div class="modal-header">
                        <h5 class="modal-title">Administrative Cancellation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small">Reason for administrative cancellation:</label>
                        <input type="text" name="reason" class="form-control" required placeholder="e.g. Disputed matter, violation of terms" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-danger btn-sm">Cancel Appointment Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
